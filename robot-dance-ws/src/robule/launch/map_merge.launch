<launch>
  <arg name="turtlebot_1" value="robule" />
  <arg name="turtlebot_2" value="modot" />

  <arg name="turtlebot_1_x_pos" default="-1.0" />
  <arg name="turtlebot_1_y_pos" default="0.0" />
  <arg name="turtlebot_1_z_pos" default="0.0" />
  <arg name="turtlebot_1_yaw" default="3.14" />

  <arg name="turtlebot_2_x_pos" default="1.0" />
  <arg name="turtlebot_2_y_pos" default="0.0" />
  <arg name="turtlebot_2_z_pos" default="0.0" />
  <arg name="turtlebot_2_yaw" default="0.0" />

  <group ns="$(arg turtlebot_1)/map_merge">
    <param name="init_pose_x" value="$(arg turtlebot_1_x_pos)" />
    <param name="init_pose_y" value="$(arg turtlebot_1_y_pos)" />
    <param name="init_pose_z" value="$(arg turtlebot_1_z_pos)" />
    <param name="init_pose_yaw" value="$(arg turtlebot_1_yaw)" />
  </group>

  <group ns="$(arg turtlebot_2)/map_merge">
    <param name="init_pose_x" value="$(arg turtlebot_2_x_pos)" />
    <param name="init_pose_y" value="$(arg turtlebot_2_y_pos)" />
    <param name="init_pose_z" value="$(arg turtlebot_2_z_pos)" />
    <param name="init_pose_yaw" value="$(arg turtlebot_2_yaw)" />
  </group>

  <node pkg="multirobot_map_merge" type="map_merge" respawn="false" name="map_merge" output="screen">
    <param name="robot_map_topic" value="map" />
    <param name="merged_map_topic" value="map" />
    <param name="world_frame" value="map" />
    <param name="known_init_poses" value="true" />
    <param name="merging_rate" value="0.5" />
    <param name="discovery_rate" value="0.05" />
    <param name="estimation_rate" value="0.1" />
    <param name="estimation_confidence" value="1.0" />
  </node>

  <node pkg="tf" type="static_transform_publisher" name="world_to_$(arg turtlebot_1)_tf_broadcaster"  args="0 0 0 0 0 0 /map /$(arg turtlebot_1)/map 100"/>
  <node pkg="tf" type="static_transform_publisher" name="world_to_$(arg turtlebot_2)_tf_broadcaster"  args="0 0 0 0 0 0 /map /$(arg turtlebot_2)/map 100" />
</launch>

<!-- http://wiki.ros.org/multirobot_map_merge -->