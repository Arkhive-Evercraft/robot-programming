<launch>
    <arg name="model" default="$(env TURTLEBOT3_MODEL)" doc="model type [burger, waffle, waffle_pi]" />

    <arg name="turtlebot_1" default="robule" />
    <arg name="turtlebot_2" default="modot" />

    <arg name="turtlebot_1_x_pos" default="-1.0" />
    <arg name="turtlebot_1_y_pos" default="0.0" />
    <arg name="turtlebot_1_z_pos" default="0.0" />
    <arg name="turtlebot_1_yaw" default="3.14" />

    <arg name="turtlebot_2_x_pos" default="1.0" />
    <arg name="turtlebot_2_y_pos" default="0.0" />
    <arg name="turtlebot_2_z_pos" default="0.0" />
    <arg name="turtlebot_2_yaw" default="0.0" />

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find turtlebot3_gazebo)/worlds/turtlebot3_stage_1.world" />
        <arg name="paused" value="false" />
        <arg name="use_sim_time" value="true" />
        <arg name="gui" value="true" />
        <arg name="headless" value="false" />
        <arg name="debug" value="false" />
    </include>

    <group ns="$(arg turtlebot_1)">
        <param name="robot_description"
            command="$(find xacro)/xacro $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro" />

        <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"
            output="screen">
            <param name="publish_frequency" type="double" value="50.0" />
            <param name="tf_prefix" value="$(arg turtlebot_1)" />
            <param name="/use_sim_time" value="true" />
        </node>

        <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
            args="-urdf -model $(arg turtlebot_1) -x $(arg turtlebot_1_x_pos) -y $(arg turtlebot_1_y_pos) -z $(arg turtlebot_1_z_pos) -Y $(arg turtlebot_1_yaw) -param robot_description">
            <param name="/use_sim_time" value="true" />
        </node>

    </group>

    <group ns="$(arg turtlebot_2)">
        <param name="robot_description"
            command="$(find xacro)/xacro $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro" />
            
        <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"
            output="screen">
            <param name="publish_frequency" type="double" value="50.0" />
            <param name="tf_prefix" value="$(arg turtlebot_2)" />
            <param name="/use_sim_time" value="true" />
        </node>

        <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
            args="-urdf -model $(arg turtlebot_2) -x $(arg turtlebot_2_x_pos) -y $(arg turtlebot_2_y_pos) -z $(arg turtlebot_2_z_pos) -Y $(arg turtlebot_2_yaw) -param robot_description">
            <param name="/use_sim_time" value="true" />
        </node>

    </group>
</launch>